#!name = 📺 B站播放页广告过滤（AIRelateAsync·加速）
#!desc = 只拦截 viewunite.v1.View/AIRelateAsync，清除播放页下方"相关推荐"广告。脚本经加速节点从 GitHub 拉取。可与 BiliVerse ADBlock 共存。
#!author = 本地自建（逻辑源自 kokoryh/Sparkle）
#!tag = 去广告
#!system = ios
#!system_version = 15
#!loon_version = 3.5.2(996)
#!date = 2026-09-21 18:20:00
#!arguments = logLevel:"off"

[Script]
播放页广告过滤 = type=http-response, pattern=^https?:\/\/(?:grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.app\.viewunite\.v1\.View\/AIRelateAsync$, script-path=https:\/\/ghfast.top\/https:\/\/raw.githubusercontent.com\/DistantSK\/biliadblock\/main\/bili_protobuf_response.js, requires-body=true, binary-body-mode=true, timeout=20, argument="[\"show\", false, false, {{{logLevel}}}]"

[MITM]
hostname = %APPEND% grpc.biliapi.net, app.bilibili.com
h2 = true
