#!name = 📺 B站播放页广告过滤（AIRelateAsync·本地）
#!desc = 只拦截 viewunite.v1.View/AIRelateAsync，清除播放页下方"相关推荐"广告。脚本需放在 Loon 沙盒 Script 目录：文件App → 我的iPhone → Loon → Script/bili_protobuf_response.js。可与 BiliVerse ADBlock 共存。
#!author = 本地自建（逻辑源自 kokoryh/Sparkle）
#!tag = 去广告
#!system = ios
#!system_version = 15
#!loon_version = 3.5.2(996)
#!date = 2026-09-21 17:40:00
#!arguments = logLevel:"off"

[Script]
播放页广告过滤 = type=http-response, pattern=^https?:\/\/(?:grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.app\.viewunite\.v1\.View\/AIRelateAsync$, script-path=Script/bili_protobuf_response.js, requires-body=true, binary-body-mode=true, timeout=20, argument="[\"show\", false, false, {{{logLevel}}}]"

[MITM]
hostname = %APPEND% grpc.biliapi.net, app.bilibili.com
h2 = true
