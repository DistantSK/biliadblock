#!name = 📺 B站播放页广告过滤（AIRelateAsync）
#!desc = 只拦截 viewunite.v1.View/AIRelateAsync，清除播放页下方"相关推荐"广告。采用 Loon 3.5.1(983)+ 新版 Script 语法。
#!author = 本地自建（逻辑源自 kokoryh/Sparkle）
#!tag = 去广告
#!system = ios
#!system_version = 15
#!loon_version = 3.5.2(996)
#!date = 2026-09-21 19:10:00
#!arguments = logLevel:"off"

[Script]
response if ${url} ~= /^https?:\/\/(grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.app\.viewunite\.v1\.View\/AIRelateAsync$/i then script("https://raw.githubusercontent.com/DistantSK/biliadblock/main/bili_protobuf_response.js", "[\"show\", false, false, \"off\"]") with tag="播放页广告过滤", timeout=20, requires_body=true, binary_body_mode=true

[MITM]
hostname = grpc.biliapi.net, app.bilibili.com, app.biliapi.net, app.biliapi.com, api.bilibili.com
h2 = true